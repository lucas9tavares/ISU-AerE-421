/BATCH
/PREP7

! Define constants
*DIM,CWD,STRING,80
CWD(1) = 'U:\09-Fall2024\AERE4210\lab05\part1\'

! Reverse video
/RGB,INDEX,100,100,100, 0
/RGB,INDEX, 80, 80, 80,13
/RGB,INDEX, 60, 60, 60,14
/RGB,INDEX, 0, 0, 0,15
/REPLOT

! Define element type
ET,1,SHELL281
KEYOPT,1,8,1
ET,2,LINK180

! Define material properties
MP,EX,1,70e9
MP,EY,1,70e9
MP,EZ,1,70e9
MP,PRXY,1,0.3
MP,PRYZ,1,0.3
MP,PRXZ,1,0.3

! Define sections
SECTYPE,1,SHELL
SECDATA,1e-3,1,0,3
SECTYPE,2,LINK
SECDATA,1e-4

! Model the geometry
K,1,0,0
K,2,0.5,0
K,3,0.5,0.1
K,4,0,0.1
L,1,2  ! Line 1
L,2,3  ! Line 2
L,3,4  ! Line 3
L,4,1  ! Line 4
A,1,2,3,4
LSEL,S,LINE,,1,3,1,0
CM,STIFF,LINE

! Meshing
ASEL,S,AREA,,1
AATT,1,,1,,1
AMESH,ALL
CMSEL,S,STIFF
LATT,1,,2,,,,2
LMESH,ALL

! Setting contraints
ALLSEL
DL,4,1,UX,0
DL,4,1,UY,0
DL,4,1,UZ,0
DL,4,1,ROTX,0
DL,4,1,ROTY,0
DL,4,1,ROTZ,0
SFL,2,PRES,-200,-800

! Solve
/SOLU
SOLVE

! Post process
/POST1

! Plot total displacement
PLNSOL,U,SUM,1,1.0
/IMAGE,SAVE,'%CWD(1)%total_displacement_contour_plot',png

! Plot xy stress
PLESOL,S,XY,1,1.0
/IMAGE,SAVE,'%CWD(1)%shear_xy',png

! Get stiffner stress
CMSEL,S,STIFF
ESLL,S

ETABLE,MEMSTR,LS,1
ETABLE,REFL
/OUTPUT,'%CWD(1)%memstr',txt
PRETAB,MEMSTR
/OUTPUT

PLETAB,MEMSTR,NOAV
/IMAGE,SAVE,'%CWD(1)%memstr',png
